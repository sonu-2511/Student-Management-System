# Copy this file to .env and adjust values. Never commit real secrets.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sms_db
DB_USERNAME=sms_user
DB_PASSWORD=sms_password

JWT_SECRET=replace-with-a-long-random-256-bit-secret-value-for-production
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173

SERVER_PORT=8080
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
LOG_LEVEL=INFO
